param(
    [Parameter(Mandatory = $true)]
    [string]$ComputerList,

    [string]$OutputPath = ".\netskope-check-$(Get-Date -Format 'yyyyMMdd-HHmmss').csv",

    [int]$TimeoutSeconds = 12
)

$RelativePath = 'ProgramData\netskope\stagent\nsusercofig.json'
$ExpectedHost = 'addon.goskope.com'

function Get-NetskopeHost {
    param(
        [string]$UncPath,
        [int]$TimeoutSeconds
    )

    $ps = [powershell]::Create()
    $null = $ps.AddScript({
        param($Path, $Expected)
        if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
            return [pscustomobject]@{ Status = 'Brak pliku'; Host = '' }
        }
        try {
            $config = Get-Content -LiteralPath $Path -Raw -ErrorAction Stop | ConvertFrom-Json
            $value = [string]$config.nsUserConfig.host
            $status = if ($value -eq $Expected) { 'OK' } else { 'Zla wartosc' }
            return [pscustomobject]@{ Status = $status; Host = $value }
        }
        catch {
            return [pscustomobject]@{ Status = 'Blad odczytu'; Host = '' }
        }
    }).AddArgument($UncPath).AddArgument($ExpectedHost)

    $async = $ps.BeginInvoke()
    if (-not $async.AsyncWaitHandle.WaitOne($TimeoutSeconds * 1000)) {
        $ps.Stop()
        $ps.Dispose()
        return [pscustomobject]@{ Status = 'Timeout'; Host = '' }
    }

    $output = @($ps.EndInvoke($async)) | Select-Object -First 1
    $ps.Dispose()
    if (-not $output) {
        return [pscustomobject]@{ Status = 'Blad odczytu'; Host = '' }
    }
    return $output
}

$computers = Get-Content -LiteralPath $ComputerList |
    ForEach-Object { $_.Trim() } |
    Where-Object { $_ -and -not $_.StartsWith('#') }

$results = foreach ($computer in $computers) {
    $unc = '\\{0}\C$\{1}' -f $computer, $RelativePath
    Write-Host ("[{0}] {1}" -f (Get-Date -Format 'HH:mm:ss'), $computer)

    $check = Get-NetskopeHost -UncPath $unc -TimeoutSeconds $TimeoutSeconds
    [pscustomobject]@{
        Computer = $computer
        Status   = $check.Status
        Host     = $check.Host
        Path     = $unc
    }
}

$results | Format-Table Computer, Status, Host -AutoSize
$results | Export-Csv -LiteralPath $OutputPath -NoTypeInformation -Encoding UTF8

$ok = @($results | Where-Object Status -eq 'OK').Count
Write-Host ("Wynik: {0}/{1} OK. Raport: {2}" -f $ok, $results.Count, (Resolve-Path $OutputPath))
